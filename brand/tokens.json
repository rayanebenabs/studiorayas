{
  "$meta": {
    "name": "Studio Rayas",
    "version": "1.2.0",
    "prefix": "sr",
    "language": "fr",
    "tagline": "On rend l'artistique technique.",
    "description": "Un système de conseil et d'atelier : craie et encre pour la rigueur, une seule terre pour le geste. Tout est à plat, à angles droits, sans dégradé, pour qu'une règle écrite suffise à reproduire la marque.",
    "fontsUrl": "https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap",
    "pangram": "Une marque qui tient sans son auteur"
  },
  "color": {
    "palette": {
      "craie":   { "$value": "#F7F2EA", "$description": "Fond principal, jamais blanc pur" },
      "papier":  { "$value": "#EAE0D2", "$description": "Surfaces secondaires, bandes" },
      "encre":   { "$value": "#17120F", "$description": "Texte, jamais noir pur" },
      "blanc":   { "$value": "#FFFFFF", "$description": "Cartes et panneaux posés sur la craie" },
      "terre":   { "$value": "#D9502E", "$description": "Le seul vif. Aplats, filets, pastilles. Pas en texte courant sur craie (3,7)" },
      "terre-profonde": { "$value": "#B33E20", "$description": "La terre quand elle porte du texte ou un bouton sur craie (5,2)" },
      "terre-braise":   { "$value": "#8E2F17", "$description": "Survol des éléments terre" },
      "safran":  { "$value": "#F2C14E", "$description": "Support de données et de statuts, jamais accent de marque" },
      "ambre":   { "$value": "#EE8B3E", "$description": "Support de données" },
      "sauge":   { "$value": "#9DBFB3", "$description": "Support de données" },
      "azur":    { "$value": "#7EA8C6", "$description": "Support de données" },
      "mousse":  { "$value": "#3F6B3C", "$description": "Succès" },
      "miel":    { "$value": "#8A5A12", "$description": "Alerte" },
      "brique":  { "$value": "#9B1C2E", "$description": "Erreur" },
      "mousse-claire": { "$value": "#8DBF86" },
      "miel-clair":    { "$value": "#E0B25A" },
      "brique-claire": { "$value": "#E87A86" },
      "nuit-2":  { "$value": "#221C18" },
      "cendre":  { "$value": "#3A322C" },
      "sable":   { "$value": "#B8AD9D" }
    },
    "semantic": {
      "bg":              { "$value": "{color.palette.craie}" },
      "surface":         { "$value": "{color.palette.blanc}" },
      "surface-2":       { "$value": "{color.palette.papier}" },
      "text":            { "$value": "{color.palette.encre}" },
      "text-muted":      { "$value": "#5E544B" },
      "border":          { "$value": "#C9BEAE" },
      "accent":          { "$value": "{color.palette.terre-profonde}" },
      "accent-hover":    { "$value": "{color.palette.terre-braise}" },
      "accent-contrast": { "$value": "{color.palette.craie}" },
      "focus":           { "$value": "{color.palette.terre-profonde}" },
      "success":         { "$value": "{color.palette.mousse}" },
      "warning":         { "$value": "{color.palette.miel}" },
      "danger":          { "$value": "{color.palette.brique}" },
      "danger-contrast": { "$value": "{color.palette.craie}" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Cormorant Garamond', 'EB Garamond', Georgia, serif" },
      "body":    { "$value": "'Archivo', 'Helvetica Neue', Arial, sans-serif" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "weight": {
      "light":    { "$value": "300" },
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" }
    }
  },
  "text": {
    "xs":  { "$value": "0.75rem" },
    "sm":  { "$value": "0.875rem" },
    "base":{ "$value": "1rem" },
    "lg":  { "$value": "1.1875rem" },
    "xl":  { "$value": "1.625rem" },
    "2xl": { "$value": "2.125rem" },
    "3xl": { "$value": "3rem" },
    "4xl": { "$value": "4rem" },
    "5xl": { "$value": "6rem" }
  },
  "leading": { "tight": { "$value": "0.98" }, "snug": { "$value": "1.2" }, "normal": { "$value": "1.65" } },
  "tracking": { "tight": { "$value": "-0.01em" }, "normal": { "$value": "0" }, "wide": { "$value": "0.22em" } },
  "space": {
    "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }, "24": { "$value": "6rem" }
  },
  "radius": { "none": { "$value": "0" }, "sm": { "$value": "0" }, "md": { "$value": "0" }, "lg": { "$value": "0" }, "full": { "$value": "999px" } },
  "border": { "width": { "default": { "$value": "1px" }, "strong": { "$value": "2px" } } },
  "shadow": {
    "sm": { "$value": "none" },
    "md": { "$value": "none" }
  },
  "motion": {
    "duration": { "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "400ms" } },
    "easing": { "standard": { "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)" }, "emphasized": { "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)" } }
  },
  "breakpoint": { "sm": { "$value": "600px" }, "md": { "$value": "900px" }, "lg": { "$value": "1180px" }, "xl": { "$value": "1440px" } },
  "component": {
    "heading": { "weight": { "$value": "{font.weight.light}" } },
    "button": {
      "radius":    { "$value": "{radius.none}" },
      "weight":    { "$value": "{font.weight.semibold}" },
      "transform": { "$value": "uppercase" },
      "tracking":  { "$value": "0.14em" },
      "padding-x": { "$value": "{space.6}" },
      "height-sm": { "$value": "2.25rem" },
      "height-md": { "$value": "2.75rem" },
      "height-lg": { "$value": "3.25rem" }
    },
    "input": { "radius": { "$value": "{radius.none}" }, "height": { "$value": "2.75rem" } },
    "card":  { "radius": { "$value": "{radius.none}" }, "padding": { "$value": "{space.8}" }, "shadow": { "$value": "none" } },
    "badge": { "radius": { "$value": "{radius.none}" } }
  },
  "$modes": {
    "dark": {
      "color.semantic.bg":              "{color.palette.encre}",
      "color.semantic.surface":         "{color.palette.nuit-2}",
      "color.semantic.surface-2":       "{color.palette.cendre}",
      "color.semantic.text":            "{color.palette.craie}",
      "color.semantic.text-muted":      "{color.palette.sable}",
      "color.semantic.border":          "#4A4037",
      "color.semantic.accent":          "{color.palette.terre}",
      "color.semantic.accent-hover":    "#E8664A",
      "color.semantic.accent-contrast": "{color.palette.encre}",
      "color.semantic.focus":           "{color.palette.terre}",
      "color.semantic.success":         "{color.palette.mousse-claire}",
      "color.semantic.warning":         "{color.palette.miel-clair}",
      "color.semantic.danger":          "{color.palette.brique-claire}",
      "color.semantic.danger-contrast": "{color.palette.encre}"
    }
  }
}
